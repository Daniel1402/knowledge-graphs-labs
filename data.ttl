@prefix vocab: <http://rdf.ontology2.com/vocab#>.
@prefix vocab: <https://daniel1402.github.io/knowledge-graphs-labs/vocab.ttl#> .
@prefix data: <https://daniel1402.github.io/knowledge-graphs-labs/data.ttl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


data:me a vocab:Student ;
    vocab:name "Daniel Kirste"^^xsd:string ;
    vocab:email "daniel.kirste@ugent.be"^^xsd:string ;
    vocab:studentID "1234567"^^xsd:integer ;
    vocab:attends data:KnowledgeGraphs ;
    vocab:born "2000-01-01"^^xsd:date ;
    vocab:knows <https://janaverl.github.io/knowledge_graphs_lab2/0001.ttl#jana>,
                <https://federickds.github.io/knowledge_graphs/data.ttl#me>.

data:KnowledgeGraphs a vocab:Course .

data:photo1 a vocab:Image ;
    vocab:title "Self portrait"@en ;
    vocab:creator data:me ;
    vocab:depicts data:me ;
    vocab:takenAt "Ugent Housing Facilities" ;
    vocab:description "A photo of me in my current home." .

data:photo2 a vocab:Image ;
    vocab:title "Me and my family"@en ;
    vocab:creator data:me ;
    vocab:depicts data:me ,
        data:myMom, 
        data:myDad,
        data:myBrother;
    vocab:takenAt "My hometown in Germany" ;
    vocab:description "A photo of me and my family back at home." .

data:photo3 a vocab:Image ;
    vocab:title "Famous Person"@en ;
    vocab:creator data:starPhotographer ;
    vocab:depicts data:veryFamousPerson ;
    vocab:takenAt "A very famous place." ;
    vocab:description "A famous photo of a famous person at a famous place." .


data:myMom a vocab:Person .
data:myDad a vocab:Person .
data:myBrother a vocab:Student .

data:starPhotographer a vocab:Person ;
    vocab:name "Star Photographer"^^xsd:string .
data:veryFamousPerson a vocab:Person ;
    vocab:name "Very Famous Person"^^xsd:string .
data:veryFamousPerson a vocab:Person .
