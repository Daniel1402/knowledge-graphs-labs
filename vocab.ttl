@prefix pgs: <https://daniel1402.github.io/knowledge-graphs-labs/vocab.ttl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

pgs:Person a rdf:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A individual human being."@en .

pgs:Student a rdf:Class ;
    rdfs:label "Student"@en ;
    rdfs:comment "A person who is enrolled at a university."@en ;
    rdfs:subClassOf pgs:Person .

pgs:Course a rdf:Class ;
    rdfs:label "Course"@en ;
    rdfs:comment "A university course."@en .

pgs:name a rdf:Property ;
    rdfs:label "name"@en ;
    rdfs:comment "The full name or abbreviated name of a person." ;
    rdfs:domain pgs:Person ;
    rdfs:range xsd:string .

pgs:studentID a rdf:Property ;
    rdfs:label "studentID"@en ;
    rdfs:comment "The unique identifier for a student."@en ;
    rdfs:domain pgs:Student ;
    rdfs:range xsd:integer .

pgs:email a rdf:Property ;
    rdfs:label "email"@en ;
    rdfs:comment "The email address of a person."@en ;
    rdfs:domain pgs:Person ;
    rdfs:range xsd:string .

pgs:attends a rdf:Property ;
    rdfs:label "attends"@en ;
    rdfs:comment "The course that a student attends."@en ;
    rdfs:domain pgs:Student ;
    rdfs:range pgs:Course .

pgs:born a rdf:Property ;
    rdfs:label "born"@en ;
    rdfs:comment "The date a person is born"@en ;
    rdfs:domain pgs:Person ;
    rdfs:range xsd:date .

pgs:knows a rdf:Property ;
    rdfs:label "knows"@en ;
    rdfs:comment "Indicates that one person knows another person"@en ;
    rdfs:domain pgs:Person ;
    rdfs:range pgs:Person .


pgs:Image a rdf:Class ;
    rdfs:label "Image"@en ;
    rdfs:comment "A photograph or visual image."@en .

pgs:depicts a rdf:Property ;
    rdfs:label "depicts"@en ;
    rdfs:comment "indicates the person depicted in an image."@en ;
    rdfs:domain pgs:Image ;
    rdfs:range pgs:Person .

pgs:title a rdf:Property ;
    rdfs:label "title"@en ;
    rdfs:comment "The title of an image."@en ;
    rdfs:domain pgs:Image ;
    rdfs:range xsd:string .

pgs:description a rdf:Property ;
    rdfs:label "description"@en ;
    rdfs:comment "A description of an image"@en ;
    rdfs:domain pgs:Image ;
    rdfs:range xsd:String .
    
pgs:creator a rdf:Property ;
    rdfs:label "creator"@en ;
    rdfs:comment "The phptpgrapher or creator of an image"@en ;
    rdfs:domain pgs:Image ;
    rdfs:range pgs:Person .

pgs:takenAt a rdf:Property ;
    rdfs:label "takenAt"@en ;
    rdfs:comment "The location where the image was taken"@en ;
    rdfs:domain pgs:Image ;
    rdfs:range xsd:string .

pgs:Person rdfs:subClassOf foaf:Person .
pgs:Student rdfs:subClassOf foaf:Person .
pgs:Image rdfs:subClassOf foaf:Image .

pgs:name rdfs:subPropertyOf foaf:name .
pgs:email rdfs:subPropertyOf foaf:mbox .
pgs:depicts rdfs:subPropertyOf foaf:depicts .
pgs:knows rdfs:subPropertyOf foaf:knows .
pgs:creator rdfs:subPropertyOf foaf:maker .
pgs:title rdfs:subPropertyOf foaf:title .